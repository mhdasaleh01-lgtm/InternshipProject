@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
    var canWrite = User.IsInRole(Role.Write);
}
<div class="page-heading">
    <h1>Products</h1>
    @if (canWrite)
    {
        <a asp-action="Create" class="button">Create product</a>
    }
</div>
@if (Model.Count == 0)
{
    <p class="empty">No products yet.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th scope="col">Name</th><th scope="col">Price</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Price.ToString("N2")</td>
                        <td class="actions">
                            <a asp-action="Details" asp-route-id="@product.Id">Details</a>
                            @if (canWrite)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id">Edit</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="danger-link">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
