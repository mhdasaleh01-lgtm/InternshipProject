@model Product
<div asp-validation-summary="All" class="validation" role="alert"></div>
<div class="field">
    <label asp-for="Name"></label>
    <input asp-for="Name" required maxlength="100" />
</div>
<div class="field">
    <label asp-for="Price"></label>
    <input asp-for="Price" type="number" step="0.01" min="0.01" max="99999999.99" required />
</div>
<div class="field">
    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="4" maxlength="1000"></textarea>
</div>
<div class="actions">
    <button type="submit" class="button">Save</button>
    <a asp-action="Index">Cancel</a>
</div>
