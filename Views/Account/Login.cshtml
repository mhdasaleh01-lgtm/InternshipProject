@model LoginViewModel
@{
    ViewData["Title"] = "Log in";
}
<section class="card narrow">
    <h1>Log in</h1>
    <p class="muted">Use your account to access products.</p>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="validation" role="alert"></div>
        <input asp-for="ReturnUrl" type="hidden" />
        <div class="field">
            <label asp-for="Username"></label>
            <input asp-for="Username" autocomplete="username" required maxlength="50" />
        </div>
        <div class="field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" required />
        </div>
        <button type="submit" class="button">Log in</button>
    </form>
</section>
